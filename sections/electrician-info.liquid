{%- style -%}
  /* 基础容器 */
  #ElectricianSection-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
  }

  .el-container {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .el-header {
    text-align: center;
    margin-bottom: {{ section.settings.header_margin_bottom }}px;
  }

  .el-title {
    font-size: {{ section.settings.title_size }}px;
    color: #000;
    font-weight: bold;
    margin-bottom: 10px;
  }

  .el-subtitle {
    font-size: {{ section.settings.subtitle_size }}px;
    color: #666;
  }

  .el-disclaimer {
    font-size: 12px;
    color: #999;
    margin-top: 10px;
  }

  /* 卡片容器：逻辑判断 */
  .el-card-wrapper {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.card_gap }}px;
  }

  /* 多于1个块时开启滑动 */
  .el-slider-enabled {
    flex-direction: row !important;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 20px;
    padding-bottom: 20px;
    -webkit-overflow-scrolling: touch;
  }
  .el-slider-enabled::-webkit-scrollbar { display: none; }

  /* 毛玻璃卡片样式 */
  .el-card {
    background: {{ section.settings.card_bg_color }};
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.4);
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    display: flex;
    overflow: hidden;
    flex: 0 0 100%;
    scroll-snap-align: start;
  }

  .el-info-content {
    flex: 1;
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .el-image-content {
    flex: 1;
    min-height: 400px;
  }

  .el-image-content img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 移动端逻辑 */
  @media screen and (max-width: 749px) {
    .el-card { flex-direction: column; }
    .el-slider-enabled .el-card { flex: 0 0 85%; } /* 露出15% */
    .el-info-content { order: 1; padding: 20px; }
    .el-image-content { order: 2; min-height: 300px; }
  }
{%- endstyle -%}

<section id="ElectricianSection-{{ section.id }}">
  <div class="el-container">
    <div class="el-header">
      {%- if section.settings.title != blank -%}<h2 class="el-title">{{ section.settings.title }}</h2>{%- endif -%}
      {%- if section.settings.subtitle != blank -%}<p class="el-subtitle">{{ section.settings.subtitle }}</p>{%- endif -%}
      {%- if section.settings.disclaimer != blank -%}<div class="el-disclaimer">{{ section.settings.disclaimer }}</div>{%- endif -%}
    </div>

    <div class="el-card-wrapper {% if section.blocks.size > 1 %}el-slider-enabled{% endif %}">
      {%- for block in section.blocks -%}
        <div class="el-card" {{ block.shopify_attributes }}>
          <div class="el-info-content">
            <div class="rte">{{ block.settings.bio }}</div>
          </div>
          <div class="el-image-content">
            {%- if block.settings.photo != blank -%}
              {{ block.settings.photo | image_url: width: 1000 | image_tag }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "电工个人信息板块",
  "settings": [
    { "type": "text", "id": "title", "label": "大标题", "default": "Our Team" },
    { "type": "range", "id": "title_size", "min": 20, "max": 80, "step": 2, "unit": "px", "label": "大标题字号", "default": 40 },
    { "type": "text", "id": "subtitle", "label": "副标题", "default": "Professional Service" },
    { "type": "range", "id": "subtitle_size", "min": 14, "max": 30, "step": 1, "unit": "px", "label": "副标题字号", "default": 18 },
    { "type": "textarea", "id": "disclaimer", "label": "免责声明" },
    { "type": "range", "id": "header_margin_bottom", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "头部间距", "default": 40 },
    { "type": "color", "id": "card_bg_color", "label": "卡片背景色", "default": "rgba(255, 255, 255, 0.2)" },
    { "type": "range", "id": "card_gap", "min": 10, "max": 100, "step": 5, "unit": "px", "label": "卡片垂直间距", "default": 30 },
    { "type": "range", "id": "container_width", "min": 800, "max": 1600, "step": 50, "unit": "px", "label": "容器最大宽度", "default": 1200 },
    { "type": "color", "id": "bg_color", "label": "板块背景色", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "顶部边距", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "底部边距", "default": 40 }
  ],
  "blocks": [
    {
      "type": "electrician_block",
      "name": "电工个人信息",
      "settings": [
        { "type": "image_picker", "id": "photo", "label": "照片" },
        { "type": "richtext", "id": "bio", "label": "简介", "default": "<p>姓名：张工<br>经验：10年</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "电工个人信息板块",
      "blocks": [
        { "type": "electrician_block" }
      ]
    }
  ]
}
{% endschema %}