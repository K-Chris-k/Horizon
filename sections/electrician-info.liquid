{%- style -%}
  /* 基础容器与全局间距 */
  #ElectricianSection-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
  }

  .el-container {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* 顶部文案样式 */
  .el-header {
    text-align: center;
    margin-bottom: {{ section.settings.header_margin_bottom }}px;
  }

  .el-title {
    font-size: {{ section.settings.title_size }}px;
    color: #000;
    font-weight: bold;
    margin-bottom: 10px;
    line-height: 1.2;
  }

  .el-subtitle {
    font-size: {{ section.settings.subtitle_size }}px;
    color: #666;
    margin-bottom: 15px;
  }

  .el-disclaimer {
    font-size: 12px;
    color: #999;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.4;
  }

  /* 个人信息卡片布局 */
  .el-card-wrapper {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.card_gap }}px;
  }

  /* 多人滑动模式逻辑 */
  .el-slider-enabled {
    display: flex !important;
    flex-direction: row !important;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 10px;
    gap: 20px;
  }

  .el-slider-enabled::-webkit-scrollbar { display: none; }

  /* 核心卡片样式：毛玻璃效果 */
  .el-card {
    background: {{ section.settings.card_bg_color }};
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.4);
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    display: flex;
    overflow: hidden;
    flex: 0 0 100%; /* 单个全宽 */
    scroll-snap-align: start;
    min-height: 400px;
  }

  .el-info-content {
    flex: 1.2;
    padding: 50px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .el-image-content {
    flex: 0.8;
    background: #f4f4f4;
  }

  .el-image-content img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* 移动端适配 */
  @media screen and (max-width: 749px) {
    .el-card {
      flex-direction: column;
      min-height: auto;
    }
    
    /* 移动端多人滑动时露出15%边缘 */
    .el-slider-enabled .el-card {
      flex: 0 0 85%; 
    }

    .el-info-content { 
      order: 1; 
      padding: 30px 20px; 
    }
    
    .el-image-content { 
      order: 2; 
      height: 300px;
      flex: none;
    }

    .el-title { font-size: calc({{ section.settings.title_size }}px * 0.7); }
  }
{%- endstyle -%}

<section id="ElectricianSection-{{ section.id }}">
  <div class="el-container">
    {%- if section.settings.title != blank -%}
      <div class="el-header">
        <h2 class="el-title">{{ section.settings.title }}</h2>
        {%- if section.settings.subtitle != blank -%}
          <p class="el-subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
        {%- if section.settings.disclaimer != blank -%}
          <div class="el-disclaimer">{{ section.settings.disclaimer }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="el-card-wrapper {% if section.blocks.size > 1 %}el-slider-enabled{% endif %}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'electrician' -%}
            <div class="el-card" {{ block.shopify_attributes }}>
              <div class="el-info-content">
                <div class="rte" style="color: {{ section.settings.card_text_color }};">
                  {{ block.settings.bio }}
                </div>
              </div>
              <div class="el-image-content">
                {%- if block.settings.photo != blank -%}
                  {{ block.settings.photo | image_url: width: 1200 | image_tag: loading: 'lazy' }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "电工个人信息板块",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "顶部文案设置"
    },
    { "type": "text", "id": "title", "label": "大标题", "default": "Meet Our Electricians" },
    { "type": "range", "id": "title_size", "min": 20, "max": 80, "step": 2, "unit": "px", "label": "大标题字号", "default": 40 },
    { "type": "text", "id": "subtitle", "label": "副标题", "default": "Certified Professionals" },
    { "type": "range", "id": "subtitle_size", "min": 14, "max": 30, "step": 1, "unit": "px", "label": "副标题字号", "default": 18 },
    { "type": "textarea", "id": "disclaimer", "label": "免责声明", "default": "* Disclaimer: All services are provided by licensed third-party contractors." },
    { "type": "range", "id": "header_margin_bottom", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "页头下方间距", "default": 40 },
    {
      "type": "header",
      "content": "卡片视觉样式"
    },
    { "type": "color", "id": "card_bg_color", "label": "卡片背景色", "default": "rgba(255, 255, 255, 0.2)" },
    { "type": "color", "id": "card_text_color", "label": "卡片文字颜色", "default": "#000000" },
    { "type": "range", "id": "card_gap", "min": 10, "max": 100, "step": 5, "unit": "px", "label": "卡片垂直间距 (非滑动模式)", "default": 30 },
    {
      "type": "header",
      "content": "整体布局控制"
    },
    { "type": "range", "id": "container_width", "min": 800, "max": 1600, "step": 50, "unit": "px", "label": "容器最大宽度", "default": 1200 },
    { "type": "color", "id": "bg_color", "label": "板块背景底色", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Section顶部内边距", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Section底部内边距", "default": 40 }
  ],
  "blocks": [
    {
      "type": "electrician",
      "name": "电工个人信息",
      "settings": [
        { "type": "image_picker", "id": "photo", "label": "上传照片" },
        { "type": "richtext", "id": "bio", "label": "个人简介", "default": "<h3>Name: John Doe</h3><p>Experience: 10+ Years</p><p>Specialization: Smart Home Wiring</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "电工个人信息板块",
      "blocks": [
        { "type": "electrician" }
      ]
    }
  ]
}
{% endschema %}